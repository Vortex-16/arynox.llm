# Server Configuration
PORT=5000

# Database Configuration
# Local MongoDB URL (Replace with your MongoDB Atlas String if using cloud)
MONGODB_URI=mongodb://localhost:27017/arynox

# API Keys
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Vector Database
# By default, we connect to the local Docker ChromaDB instance
CHROMA_URL=http://localhost:8000

# Authentication (Google OAuth 2.0)
# Create project at console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_secret_key_from_google
JWT_SECRET=any_random_string_to_secure_your_local_tokens
